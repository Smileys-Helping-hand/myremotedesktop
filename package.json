{
  "name": "remotedesk",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Low-latency WebRTC remote desktop for Windows and Linux \u2014 React + Tauri, with native OS input injection and an embedded signaling server in Rust",
  "scripts": {
    "dev": "tauri dev",
    "dev:app": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "start:signal": "tsx server/index.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:signaling": "tsx scripts/check-signaling.ts",
    "check:discovery": "tsx scripts/check-host-discovery.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/ws": "^8.18.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.5"
  }
}
