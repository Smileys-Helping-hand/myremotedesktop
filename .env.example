# RemoteDesk configuration.
#
# The desktop app needs none of this: it embeds its own signaling server and
# picks a port at startup. These variables only affect the optional standalone
# relay (`npm run start:signal`), which you run when two peers cannot reach each
# other directly and need a rendezvous point on a third machine.

# Port the standalone relay listens on. The desktop app defaults to 4000 too,
# and walks up to 4009 if that port is already taken.
SIGNAL_PORT=4000

# Interface to bind. 0.0.0.0 accepts connections from other machines on the
# network; use 127.0.0.1 to keep the relay local to this machine.
SIGNAL_HOST=0.0.0.0
